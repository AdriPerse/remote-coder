# Copy to .env and fill in. Nothing here is read from the shell environment
# except MOONSHOT_API_KEY, which may also be set as a user env var.

# --- Model (Moonshot / Kimi, per-token, no subscription) -------------------
MOONSHOT_API_KEY=
RC_BASE_URL=https://api.moonshot.ai/v1
RC_MODEL=kimi-k3
# Cheap model for subagents and summarization. K3 output is $15/M; k2.6 is $4/M.
RC_SMALL_MODEL=kimi-k2.6
# K3 only: low | high | max (default max). Reasoning tokens bill as output,
# so this is the main cost dial inside the flagship.
RC_REASONING_EFFORT=high

# --- Web search (optional) -------------------------------------------------
# Free tier at tavily.com: 1000 searches/month. Gives the agent a web_search
# tool for current docs/errors/facts. Empty -> the tool is simply not offered.
TAVILY_API_KEY=

# --- Telegram transport ----------------------------------------------------
# A NEW bot from @BotFather -- never reuse MusicLore's token: only one process
# may poll a token, the second gets HTTP 409.
RC_TELEGRAM_TOKEN=
RC_ALLOWED_CHAT_ID=

# --- Repo picker ------------------------------------------------------------
# Roots scanned (one and two levels deep) for the /repo tap-to-pick list.
# Semicolon-separated; defaults to ~/Projects and ~/Documents.
RC_REPO_ROOTS=C:\Projects;C:\Users\you\Documents

# --- Safety ----------------------------------------------------------------
# Tools that must be approved from the phone before they run.
RC_INTERRUPT_ON=execute,write_file,edit_file,delete
# Shell command timeout, seconds.
RC_EXECUTE_TIMEOUT=120
# Env vars the agent's shell must never see (comma-separated, matched exactly).
# The agent would otherwise be able to read -- and exfiltrate -- its own key.
RC_SCRUB_ENV=MOONSHOT_API_KEY,RC_TELEGRAM_TOKEN,MUSICLORE_TELEGRAM_TOKEN,TAVILY_API_KEY,ANTHROPIC_API_KEY,OPENAI_API_KEY
